# ===========================================================================
# ACCIMAP : variables d'environnement
# Copiez ce fichier en ".env" et adaptez les valeurs. NE COMMITEZ JAMAIS .env.
# ===========================================================================

# --- Django ---------------------------------------------------------------
# Générer une clé :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production : https://mon-service.onrender.com (séparés par des virgules)
CSRF_TRUSTED_ORIGINS=

# --- Base de données PostgreSQL + PostGIS ---------------------------------
# Option 1 (recommandée, utilisée par Render) : une seule URL
# DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/accimap
# Option 2 : variables séparées
DB_NAME=accimap
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Mettre True si la base distante exige SSL (URL externe Render)
DB_SSL_REQUIRE=False

# --- GDAL / GEOS (Windows ou macOS uniquement, laisser vide sous Linux) ----
# Exemple Windows (OSGeo4W) : C:\OSGeo4W\bin\gdal310.dll
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=

# --- Authentification par OTP ---------------------------------------------
# True = SMS SIMULÉ (développement / soutenance) ; False = SMS réels (production). Voir « Fournisseur SMS ».
OTP_DEV_MODE=True
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_DELAY_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
# Indicatif ajouté aux numéros saisis sans préfixe (Togo)
DEFAULT_PHONE_COUNTRY_CODE=+228

# --- Fournisseur SMS -------------------------------------------------------
# Deux modes, choisis UNIQUEMENT par ces variables (aucune modification de code) :
#
# MODE SIMULATION / DÉVELOPPEMENT / SOUTENANCE (par défaut ici)
#   SMS_BACKEND=accounts.sms.ConsoleSMSBackend   + OTP_DEV_MODE=True (plus haut)
#   Aucun SMS réel, aucun crédit, aucune clé, fonctionne hors ligne. Le SMS simulé (numéro masqué) est écrit dans
#   la console du serveur et le code est présenté dans un bandeau « Mode développement — SMS simulé ».
#   La génération, l'expiration, les tentatives, le renvoi, la validation et la connexion restent RÉELS.
#
# MODE PRODUCTION (Brevo, https://www.brevo.com)
#   SMS_BACKEND=accounts.sms.BrevoSMSBackend     + OTP_DEV_MODE=False
#   SMS_API_KEY : Brevo > Paramètres > SMTP & API > Clés API (xkeysib-...). JAMAIS dans Git ni dans le code.
#   SMS_SENDER_ID : Sender ID approuvé par Brevo pour le Togo (11 caractères max). Crédits SMS requis.
#
# Vérifier : python manage.py sms_test --account    puis    python manage.py sms_test +228XXXXXXXX
SMS_BACKEND=accounts.sms.ConsoleSMSBackend
SMS_API_KEY=
SMS_SENDER_ID=ACCIMAP
# Non utilisé par Brevo (réservé à un autre fournisseur)
SMS_API_SECRET=

# --- Divers ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5
# Stockage des photos : disque local par défaut. À remplacer plus tard par un
# stockage persistant/externe (voir config/settings.py, section « Fichiers »).
MEDIA_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
LOG_LEVEL=INFO
# Production uniquement (HSTS en secondes ; SSL redirect actif par défaut)
SECURE_HSTS_SECONDS=3600
SECURE_SSL_REDIRECT=True

# --- Carte et zone de couverture (Phase 4) --------------------------------
# Fond de carte (OpenStreetMap par défaut)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Zone de couverture : par défaut, rectangle INDICATIF non officiel (voir data/README.md).
# Pour brancher la limite officielle du Grand Lomé :
COVERAGE_ZONE_GEOJSON=
COVERAGE_ZONE_IS_OFFICIAL=False
COVERAGE_ZONE_NAME=
# Photos : plus grand côté après ré-encodage (pixels)
PHOTO_MAX_DIMENSION=1920

# --- Carte publique (Phase 5) ---------------------------------------------
# Afficher la description libre dans les popups publics ? (False par défaut : elle peut
# contenir des données personnelles). Les photos ne sont JAMAIS publiques.
PUBLIC_MAP_SHOW_DESCRIPTION=False
PUBLIC_MAP_MAX_FEATURES=5000
ADMIN_MAP_MAX_FEATURES=10000

# --- Indication du lieu dans le parcours de signalement (Phase 7 bis) --------
# Le serveur interroge Nominatim (OpenStreetMap) pour afficher « Quartier, Ville ». Facultatif.
REVERSE_GEOCODING_ENABLED=True
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
# Contact (e-mail ou site) à indiquer dans le User-Agent, exigé par la politique d'usage de Nominatim
GEOCODER_CONTACT=

# --- Exports (Phase 7) ----------------------------------------------------
# Au-delà, l'export CSV/Excel est refusé (affinez les filtres) et le PDF est tronqué avec mention explicite
EXPORT_MAX_ROWS=20000
EXPORT_PDF_MAX_ROWS=500

# --- Déploiement (Docker / Render, voir docs/DEPLOIEMENT_RENDER.md) ---------
# Superutilisateur créé au démarrage du conteneur s'il n'existe pas (jamais modifié ensuite)
ADMIN_PHONE=
ADMIN_PASSWORD=
# True = crée 60 signalements de démonstration au démarrage (une seule fois)
SEED_DEMO=False
# Nombre de processus gunicorn
WEB_CONCURRENCY=2
